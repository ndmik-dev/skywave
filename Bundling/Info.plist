<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>Skywave</string>
	<key>CFBundleDisplayName</key>
	<string>Skywave</string>
	<key>CFBundleIdentifier</key>
	<string>com.ndmik.Skywave</string>
	<key>CFBundleExecutable</key>
	<string>Skywave</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>0.1</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<!-- Menubar only: without this the app also shows up in the Dock. -->
	<key>LSUIElement</key>
	<true/>
	<!-- Radio Alhara is the only station left on plain HTTP. Radiojar answers
	     even an https:// request with a 302 to http:// on a rotating host
	     (n02, n05, n0c…), so the exception has to cover the whole domain. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSExceptionDomains</key>
		<dict>
			<key>radiojar.com</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSIncludesSubdomains</key>
				<true/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
